{
  "name": "@omp-desktop/server",
  "version": "0.2.6",
  "description": "OMP Desktop local daemon",
  "files": [
    "dist/server",
    "dist/src",
    "dist/scripts",
    "!dist/**/*.map",
    "README.md",
    ".env.example"
  ],
  "type": "module",
  "types": "./dist/server/server/exports.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server/server/exports.d.ts",
      "source": "./src/server/exports.ts",
      "default": "./dist/server/server/exports.js"
    },
    "./utils/tool-call-parsers": {
      "types": "./dist/server/utils/tool-call-parsers.d.ts",
      "source": "./src/utils/tool-call-parsers.ts",
      "default": "./dist/server/utils/tool-call-parsers.js"
    },
    "./agent-hooks": {
      "types": "./dist/server/terminal/agent-hooks/provider-registry.d.ts",
      "source": "./src/terminal/agent-hooks/provider-registry.ts",
      "default": "./dist/server/terminal/agent-hooks/provider-registry.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "cross-env PASEO_NODE_ENV=development node --import tsx scripts/dev-runner.ts",
    "dev:tsx": "cross-env PASEO_NODE_ENV=development tsx watch --ignore '**/*.timestamp-*' scripts/dev-runner.ts",
    "clean": "node ../../scripts/clean-package-dist.mjs",
    "build": "npm run build:lib && npm run build:scripts",
    "build:clean": "npm run clean && npm run build",
    "build:lib": "tsc -p tsconfig.server.json --incremental false && node -e \"const fs=require('node:fs'); fs.mkdirSync('dist/server/server/speech/providers/local/sherpa/assets',{recursive:true}); fs.copyFileSync('src/server/speech/providers/local/sherpa/assets/silero_vad.onnx','dist/server/server/speech/providers/local/sherpa/assets/silero_vad.onnx'); fs.cpSync('src/terminal/shell-integration','dist/server/terminal/shell-integration',{recursive:true}); fs.cpSync('src/terminal/shell-integration','dist/src/terminal/shell-integration',{recursive:true}); fs.copyFileSync('src/terminal/terminal-ts-loader.mjs','dist/server/terminal/terminal-ts-loader.mjs'); fs.rmSync('dist/server/skills',{recursive:true,force:true}); fs.cpSync('../../skills','dist/server/skills',{recursive:true});\"",
    "build:scripts": "tsc -p tsconfig.scripts.json --incremental false && node -e \"const fs=require('node:fs'); fs.mkdirSync('dist/scripts',{recursive:true}); fs.copyFileSync('scripts/mcp-stdio-socket-bridge-cli.mjs','dist/scripts/mcp-stdio-socket-bridge-cli.mjs'); fs.copyFileSync('scripts/github-git-askpass.mjs','dist/scripts/github-git-askpass.mjs'); fs.copyFileSync('scripts/github-git-askpass.cmd','dist/scripts/github-git-askpass.cmd'); if(process.platform!=='win32')fs.chmodSync('dist/scripts/github-git-askpass.mjs',0o700);\"",
    "prepack": "npm run build:clean && npm --prefix ../.. run build:daemon-web-ui",
    "start": "node dist/scripts/supervisor-entrypoint.js",
    "typecheck": "tsgo -p tsconfig.server.typecheck.json --noEmit",
    "generate:config-schema": "tsx scripts/generate-config-schema.ts",
    "test": "npm run test:unit",
    "test:unit": "vitest run src/server/agent/provider-registry.test.ts src/server/agent/providers/omp",
    "test:integration:real": "vitest run src/server/daemon-e2e/omp.real.e2e.test.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@babel/parser": "^7.29.8",
    "@isaacs/ttlcache": "^2.1.4",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@napi-rs/keyring": "^1.3.0",
    "@octokit/auth-oauth-device": "^8.0.4",
    "@octokit/request": "^10.0.15",
    "@octokit/rest": "^22.0.1",
    "@omp-desktop/client": "0.2.6",
    "@omp-desktop/highlight": "0.2.6",
    "@omp-desktop/protocol": "0.2.6",
    "@omp-desktop/relay": "0.2.6",
    "@vscode/ripgrep": "^1.18.0",
    "@xterm/headless": "^6.0.0",
    "ai": "5.0.78",
    "ajv": "^8.20.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.3",
    "esbuild": "^0.25.12",
    "express": "^4.18.2",
    "fast-deep-equal": "^3.1.3",
    "lru-cache": "^11.5.1",
    "mnemonic-id": "^3.2.7",
    "node-pty": "1.2.0-beta.15",
    "openai": "^6.44.0",
    "p-limit": "^7.3.0",
    "p-memoize": "^8.0.0",
    "p-throttle": "^8.1.0",
    "pino": "^10.2.0",
    "pino-pretty": "^13.1.3",
    "qrcode": "^1.5.4",
    "rotating-file-stream": "^3.2.9",
    "sherpa-onnx-node": "1.12.28",
    "strip-ansi": "^7.1.2",
    "tree-kill": "^1.2.2",
    "undici": "^6.23.0",
    "uuid": "^9.0.1",
    "which": "^5.0.0",
    "ws": "^8.14.2",
    "yaml": "^2.8.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/express": "^4.17.20",
    "@types/node": "^20.9.0",
    "@types/qrcode": "^1.5.6",
    "@types/uuid": "^9.0.7",
    "@types/ws": "^8.5.8",
    "@vitest/ui": "^4.1.6",
    "cross-env": "^10.1.0",
    "tsx": "^4.6.0",
    "typescript": "^5.2.2",
    "vitest": "^4.1.6"
  },
  "overrides": {
    "lightningcss": "1.30.1"
  }
}
