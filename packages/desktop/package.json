{
  "name": "@omp-desktop/desktop",
  "version": "0.2.0",
  "private": true,
  "description": "OMP Desktop Electron application",
  "license": "AGPL-3.0-or-later",
  "author": "OMP Desktop contributors",
  "main": "dist/main.js",
  "scripts": {
    "build": "npm --prefix ../.. run build:server:clean && npm run build:main && electron-builder --config electron-builder.yml",
    "build:main": "tsc -p tsconfig.json --incremental false",
    "dev": "./scripts/dev.sh",
    "dev:win": "powershell ./scripts/dev.ps1",
    "test": "vitest run --exclude \"e2e/**\"",
    "typecheck": "tsgo --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@omp-desktop/cli": "*",
    "@omp-desktop/server": "*",
    "electron-log": "^5.4.3",
    "ws": "^8.14.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.6.0",
    "@types/ws": "^8.5.14",
    "electron": "41.2.0",
    "electron-builder": "26.8.1",
    "typescript": "5.9.3",
    "unzip-crx-3": "^0.2.0",
    "vitest": "^4.1.6",
    "wait-on": "8.0.5"
  }
}
