{
  "name": "@omp-desktop/cli",
  "version": "0.2.1",
  "description": "OMP Desktop command-line client",
  "bin": {
    "omp-desktop": "bin/omp-desktop"
  },
  "files": [
    "bin",
    "dist",
    "!dist/**/*.map"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node ../../scripts/clean-package-dist.mjs",
    "build": "tsc -p tsconfig.json --incremental false",
    "build:clean": "npm run clean && npm run build",
    "prepack": "npm run build:clean",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run src"
  },
  "dependencies": {
    "@clack/prompts": "^1.0.0",
    "@omp-desktop/client": "0.2.1",
    "@omp-desktop/protocol": "0.2.1",
    "@omp-desktop/server": "0.2.1",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "mime-types": "^2.1.35",
    "tree-kill": "^1.2.2",
    "ws": "^8.14.2",
    "yaml": "^2.8.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/mime-types": "^3.0.1",
    "@types/ws": "^8.5.8",
    "tsx": "^4.6.0",
    "typescript": "^5.2.2",
    "vitest": "^4.1.6",
    "zx": "^8.8.5"
  }
}
